# --- Base de donnees ---
# PostgreSQL (defaut) :
DB_URL=jdbc:postgresql://localhost:5432/blockchain_badges
# MySQL : remplacer la ligne ci-dessus par
# DB_URL=jdbc:mysql://localhost:3306/blockchain_badges
DB_USER=postgres
DB_PASSWORD=postgres
# true (defaut) : l'application cree la base si elle n'existe pas (le compte DB_USER doit pouvoir creer une base).
# false : vous creez la base vous-meme.
DB_AUTO_CREATE=true

# --- Ethereum Sepolia (reseau de TEST) ---
# Cle privee d'un portefeuille DE TEST (MetaMask > Details du compte > Exporter la cle privee).
# Ne JAMAIS utiliser un portefeuille qui contient de vrais fonds. 64 caracteres hexadecimaux, avec ou sans 0x.
ETH_PRIVATE_KEY=
# Optionnel : noeud Sepolia. Par defaut un noeud public gratuit. Infura / Alchemy : https://sepolia.infura.io/v3/VOTRE_CLE
# ETH_RPC_URL=

# --- A remplir apres "mvn compile exec:java" (il deploie le smart contract et affiche cette ligne) ---
CONTRACT_ADDRESS=

# --- Badges NFT (facultatif) : "mvn compile exec:java -Dexec.args=nft" deploie BadgeNFT et affiche cette ligne ---
NFT_CONTRACT_ADDRESS=

# --- Authentification ---
# Compte de l'ecole : cree au demarrage. C'est avec lui qu'on se connecte pour delivrer les badges.
ECOLE_EMAIL=ecole@example.com
ECOLE_PASSWORD=
# Secret qui signe les jetons : 32 caracteres minimum, aleatoires. Vide : deconnexion de tous a chaque redemarrage.
JWT_SECRET=

# --- Optionnel ---
PORT=3000

# Adresse publique du site, utilisee dans le QR code des certificats PDF. Vide : deduite de la requete (http://localhost:3000 en local).
PUBLIC_URL=
